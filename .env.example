# ============================================================
# NWU Soccer Institute - Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values
# cp .env.example .env.local

# ── MongoDB ─────────────────────────────────────────────────
# Option A: MongoDB Atlas (FREE cloud - RECOMMENDED)
#   1. Go to https://cloud.mongodb.com  → sign up free
#   2. Create a FREE cluster (M0 Sandbox)
#   3. Database Access → Add user with password
#   4. Network Access → Add IP → Allow access from anywhere (0.0.0.0/0)
#   5. Connect → Drivers → copy the URI and paste below
#   Replace <username>, <password>, <clustername> with yours:
MONGODB_URI=mongodb+srv://<username>:<password>@<clustername>.mongodb.net/nwu-soccer?retryWrites=true&w=majority

# Option B: Local MongoDB (must have MongoDB Community installed & running)
# MONGODB_URI=mongodb://localhost:27017/nwu-soccer

# ── NextAuth ────────────────────────────────────────────────
# Generate a secret: open terminal and run:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=replace-this-with-your-generated-secret
NEXTAUTH_URL=http://localhost:3000

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=NWU Soccer Institute
